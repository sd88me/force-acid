# force-acid.conf  — optional. Copy to  force-acid.conf  next to the binary
# (the run script picks it up automatically) to override CCs / channels
# without rebuilding. Lines are  key = number , '#' starts a comment.

# --- channels (1-16) --------------------------------------------------------
control_channel  = 1      # CC + note-in that force-acid listens on
a_channel        = 1      # Seq A's own output channel (FORCE-ONLY, no Move equiv.)
b_channel        = 1      # Seq B's own output channel -- set different from
                           # a_channel to route A and B to two separate Force
                           # instrument tracks; leave both at 1 for the old
                           # single-channel + Blend-only behaviour.
forward_unmapped = 1      # 1 = pass CCs we don't use through to the synth, 0 = drop

# --- CC map (0-127). Defaults shown; uncomment to change. ------------------
# Block A = Sequence A, Block B = Sequence B, then Global. See docs/CC-MAP.md.

# a_generate = 20
# a_mutate   = 21
# a_density  = 22
# a_accent   = 23
# a_slide    = 24
# a_octaves  = 25
# a_length   = 26
# a_gate     = 27
# a_channel  = 28
# a_offset   = 29
# a_dir      = 30

# b_generate = 40
# b_mutate   = 41
# b_density  = 42
# b_accent   = 43
# b_slide    = 44
# b_octaves  = 45
# b_length   = 46
# b_gate     = 47
# b_channel  = 48
# b_offset   = 49
# b_dir      = 50

# scale      = 70
# root       = 71
# b_tune     = 72
# blend      = 73
# a_algo     = 74
# b_algo     = 75
# reset_bars = 76
# swing      = 77
# jitter     = 78
# auto_gen   = 79
